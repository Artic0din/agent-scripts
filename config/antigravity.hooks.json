{
  "metisary": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/block-dangerous-git.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash $HOME/.claude/hooks/pre-commit-secrets.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}

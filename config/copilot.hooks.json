{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "bash $HOME/.claude/hooks/block-dangerous-git.sh",
        "cwd": ".",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "bash $HOME/.claude/hooks/pre-commit-secrets.sh --copilot",
        "cwd": ".",
        "timeoutSec": 60
      }
    ]
  }
}
